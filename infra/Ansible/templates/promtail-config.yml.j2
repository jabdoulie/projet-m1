# Généré par Ansible — envoi des logs vers Loki sur la VM monitoring
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/promtail-positions.yaml

clients:
  - url: {{ loki_push_url }}

scrape_configs:
  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          host: "{{ inventory_hostname }}"
          __path__: /var/log/*.log

  - job_name: syslog
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: "{{ inventory_hostname }}"
          __path__: /var/log/syslog

  - job_name: containers
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker
          host: "{{ inventory_hostname }}"
          __path__: /var/lib/docker/containers/*/*-json.log
